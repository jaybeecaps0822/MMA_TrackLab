rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // - uid: string (required)
    // - displayName: string (required)
    // - email: string (required, email format)
    // - role: string (required, enum: student, teacher, admin)
    //
    // Collection: lab_usage
    // - uid: string (required)
    // - userName: string (required)
    // - checkIn: timestamp (required)
    // - checkOut: timestamp (optional)
    // - purpose: string (required)
    // - station: string (optional)
    //
    // Collection: schedules
    // - labId: string (required)
    // - day: string (required)
    // - date: string (optional)
    // - startTime: string (required)
    // - endTime: string (required)
    // - teacherName: string (required)
    // - subject: string (required)
    // - yearSection: string (required)
    //
    // Collection: laboratories
    // - name: string (required)
    // - description: string (optional)
    //
    // Collection: trainers
    // - name: string (required)
    // - specialization: string (optional)
    // - createdAt: timestamp (required)
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
         (request.auth.token.email == "jaybeecapoy0822@gmail.com"));
    }

    function isTeacher() {
      return isAuthenticated() && 
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')) || 
         isAdmin());
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role']) &&
             data.uid is string &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() < 100 &&
             data.role in ['student', 'teacher', 'admin'];
    }

    function isValidLabUsage(data) {
      return data.keys().hasAll(['uid', 'userName', 'checkIn', 'purpose', 'station']) &&
             data.uid is string &&
             data.userName is string && data.userName.size() > 0 &&
             data.checkIn is timestamp &&
             data.purpose is string && data.purpose.size() > 0 && data.purpose.size() < 500 &&
             data.station is string && data.station.size() > 0 && data.station.size() < 50;
    }

    function isValidLaboratory(data) {
      return data.keys().hasAll(['name', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.createdAt is timestamp &&
             (!('description' in data) || (data.description is string && data.description.size() < 500)) &&
             (!('capacity' in data) || ((data.capacity is int || data.capacity is number) && data.capacity > 0 && data.capacity <= 500));
    }

    function isValidTrainer(data) {
      return data.keys().hasAll(['name', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.createdAt is timestamp &&
             (!('specialization' in data) || (data.specialization is string && data.specialization.size() < 500)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() < 1000000)) &&
             (!('email' in data) || (data.email is string && data.email.size() < 120)) &&
             (!('employeeId' in data) || (data.employeeId is string && data.employeeId.size() < 50)) &&
             (!('department' in data) || (data.department is string && data.department.size() < 100)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() < 50)) &&
             (!('status' in data) || (data.status in ['active', 'on_leave', 'adjunct']));
    }

    function isValidSection(data) {
      return data.keys().hasAll(['name', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.createdAt is timestamp &&
             (!('yearLevel' in data) || (data.yearLevel is string && data.yearLevel.size() < 50)) &&
             (!('department' in data) || (data.department is string && data.department.size() < 100)) &&
             (!('studentCount' in data) || ((data.studentCount is int || data.studentCount is number) && data.studentCount >= 0 && data.studentCount <= 500)) &&
             (!('adviser' in data) || (data.adviser is string && data.adviser.size() < 100)) &&
             (!('room' in data) || (data.room is string && data.room.size() < 100)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() < 1000));
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['name', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 150 &&
             data.createdAt is timestamp &&
             (!('code' in data) || (data.code is string && data.code.size() < 50)) &&
             (!('category' in data) || (data.category is string && data.category.size() < 100)) &&
             (!('units' in data) || ((data.units is int || data.units is number) && data.units >= 0 && data.units <= 30)) &&
             (!('hoursPerWeek' in data) || ((data.hoursPerWeek is int || data.hoursPerWeek is number) && data.hoursPerWeek >= 0 && data.hoursPerWeek <= 40)) &&
             (!('description' in data) || (data.description is string && data.description.size() < 1000));
    }

    function isValidWorkstationIssue(data) {
      return data.keys().hasAll(['labId', 'station', 'description', 'reportedByUid', 'reportedByName', 'status', 'createdAt']) &&
             data.labId is string &&
             data.station is string && data.station.size() > 0 && data.station.size() < 50 &&
             data.description is string && data.description.size() > 0 && data.description.size() < 1000 &&
             data.reportedByUid is string &&
             data.reportedByName is string &&
             data.status in ['open', 'in_progress', 'resolved'] &&
             data.createdAt is timestamp &&
             (!('category' in data) || (data.category in ['hardware', 'software', 'network', 'peripheral', 'other'])) &&
             (!('severity' in data) || (data.severity in ['low', 'medium', 'critical'])) &&
             (!('resolutionNotes' in data) || (data.resolutionNotes is string && data.resolutionNotes.size() < 1000)) &&
             (!('resolvedByName' in data) || (data.resolvedByName is string && data.resolvedByName.size() < 100)) &&
             (!('resolvedAt' in data) || data.resolvedAt is timestamp);
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && 
                    (request.resource.data.role == 'student' || 
                     (request.resource.data.role == 'admin' && request.auth.token.email == "jaybeecapoy0822@gmail.com" && request.auth.token.email_verified == true));
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && 
                    ((isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin());
      allow delete: if isAdmin();
    }

    // Lab Usage Rules
    match /lab_usage/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidLabUsage(request.resource.data) && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && 
                    (resource.data.uid == request.auth.uid || isTeacher()) &&
                    request.resource.data.checkIn == resource.data.checkIn &&
                    request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['labId', 'day', 'startTime', 'endTime', 'teacherName', 'subject', 'yearSection', 'createdAt']) &&
             data.labId is string &&
             data.day in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'] &&
             data.startTime is string && data.endTime is string &&
             data.teacherName is string && data.subject is string && data.yearSection is string &&
             data.createdAt is timestamp &&
             (!('date' in data) || (data.date is string && data.date.size() < 50)) &&
             (!('trainerId' in data) || (data.trainerId is string));
    }

    // Schedule Rules
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() && isValidSchedule(request.resource.data);
      allow delete: if isTeacher();
    }

    // Laboratory Rules
    match /laboratories/{labId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidLaboratory(request.resource.data);
      allow delete: if isAdmin();
    }

    // Trainer / Faculty Rules
    match /trainers/{trainerId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() && isValidTrainer(request.resource.data);
      allow update: if isTeacher() && isValidTrainer(request.resource.data);
      allow delete: if isTeacher();
    }

    // Section Rules
    match /sections/{sectionId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() && isValidSection(request.resource.data);
      allow update: if isTeacher() && isValidSection(request.resource.data);
      allow delete: if isTeacher();
    }

    // Subject Rules
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() && isValidSubject(request.resource.data);
      allow update: if isTeacher() && isValidSubject(request.resource.data);
      allow delete: if isTeacher();
    }

    // Workstation Issues & Maintenance Rules
    match /workstation_issues/{issueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidWorkstationIssue(request.resource.data) && request.resource.data.reportedByUid == request.auth.uid;
      allow update: if isAuthenticated() && isValidWorkstationIssue(request.resource.data) &&
                    (resource.data.reportedByUid == request.auth.uid || isTeacher());
      allow delete: if isTeacher();
    }

    function isValidAcUsage(data) {
      return data.keys().hasAll(['labId', 'acUnit', 'turnedOnAt', 'turnedOnByUid', 'turnedOnByName', 'status']) &&
             data.labId is string &&
             data.acUnit is string && data.acUnit.size() > 0 && data.acUnit.size() < 100 &&
             data.turnedOnAt is timestamp &&
             data.turnedOnByUid is string &&
             data.turnedOnByName is string && data.turnedOnByName.size() > 0 && data.turnedOnByName.size() < 100 &&
             data.status in ['active', 'completed'] &&
             (!('temperature' in data) || ((data.temperature is int || data.temperature is number) && data.temperature >= 16 && data.temperature <= 32)) &&
             (!('mode' in data) || (data.mode is string && data.mode.size() < 50)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() < 1000)) &&
             (!('closingNotes' in data) || (data.closingNotes is string && data.closingNotes.size() < 1000)) &&
             (!('durationMinutes' in data) || (data.durationMinutes is int || data.durationMinutes is number)) &&
             (!('estimatedKWh' in data) || (data.estimatedKWh is int || data.estimatedKWh is number)) &&
             (!('turnedOffAt' in data) || data.turnedOffAt == null || data.turnedOffAt is timestamp) &&
             (!('turnedOffByUid' in data) || data.turnedOffByUid == null || data.turnedOffByUid is string) &&
             (!('turnedOffByName' in data) || data.turnedOffByName == null || data.turnedOffByName is string) &&
             (!('labName' in data) || (data.labName is string && data.labName.size() < 150));
    }

    // Air-Conditioning Usage Tracking Rules
    match /ac_usage/{usageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidAcUsage(request.resource.data) && request.resource.data.turnedOnByUid == request.auth.uid;
      allow update: if isAuthenticated() && isValidAcUsage(request.resource.data);
      allow delete: if isAdmin();
    }

    function isValidLabItem(data) {
      return data.keys().hasAll(['name', 'labId', 'category', 'assetTag', 'totalQuantity', 'availableQuantity', 'condition']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 150 &&
             data.labId is string &&
             data.category is string &&
             data.assetTag is string && data.assetTag.size() > 0 && data.assetTag.size() < 80 &&
             (data.totalQuantity is int || data.totalQuantity is number) && data.totalQuantity >= 0 &&
             (data.availableQuantity is int || data.availableQuantity is number) && data.availableQuantity >= 0 &&
             data.condition in ['excellent', 'good', 'fair', 'maintenance'] &&
             (!('location' in data) || (data.location is string && data.location.size() < 150)) &&
             (!('description' in data) || (data.description is string && data.description.size() < 1000)) &&
             (!('labName' in data) || (data.labName is string && data.labName.size() < 150)) &&
             (!('requiresApproval' in data) || data.requiresApproval is bool) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidBorrowRequest(data) {
      return data.keys().hasAll(['itemId', 'itemName', 'labId', 'borrowerUid', 'borrowerName', 'purpose', 'quantity', 'status', 'requestedAt', 'expectedReturnDate']) &&
             data.itemId is string &&
             data.itemName is string && data.itemName.size() > 0 && data.itemName.size() < 150 &&
             data.labId is string &&
             data.borrowerUid is string &&
             data.borrowerName is string && data.borrowerName.size() > 0 && data.borrowerName.size() < 100 &&
             data.purpose is string && data.purpose.size() > 0 && data.purpose.size() < 1000 &&
             (data.quantity is int || data.quantity is number) && data.quantity > 0 &&
             data.status in ['pending', 'approved', 'rejected', 'returned', 'overdue'] &&
             data.requestedAt is timestamp &&
             data.expectedReturnDate is timestamp &&
             (!('itemAssetTag' in data) || (data.itemAssetTag is string && data.itemAssetTag.size() < 100)) &&
             (!('labName' in data) || (data.labName is string && data.labName.size() < 150)) &&
             (!('borrowerEmail' in data) || (data.borrowerEmail is string && data.borrowerEmail.size() < 120)) &&
             (!('borrowerIdNumber' in data) || (data.borrowerIdNumber is string && data.borrowerIdNumber.size() < 60)) &&
             (!('borrowerRole' in data) || data.borrowerRole in ['student', 'teacher', 'admin']) &&
             (!('reviewedAt' in data) || data.reviewedAt == null || data.reviewedAt is timestamp) &&
             (!('reviewedByUid' in data) || data.reviewedByUid == null || data.reviewedByUid is string) &&
             (!('reviewedByName' in data) || data.reviewedByName == null || data.reviewedByName is string) &&
             (!('reviewNotes' in data) || data.reviewNotes == null || (data.reviewNotes is string && data.reviewNotes.size() < 1000)) &&
             (!('returnedAt' in data) || data.returnedAt == null || data.returnedAt is timestamp) &&
             (!('returnedReceivedByUid' in data) || data.returnedReceivedByUid == null || data.returnedReceivedByUid is string) &&
             (!('returnedReceivedByName' in data) || data.returnedReceivedByName == null || data.returnedReceivedByName is string) &&
             (!('returnCondition' in data) || (data.returnCondition is string && data.returnCondition.size() < 50)) &&
             (!('returnNotes' in data) || data.returnNotes == null || (data.returnNotes is string && data.returnNotes.size() < 1000));
    }

    // Laboratory Items Inventory Rules
    match /lab_items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() && isValidLabItem(request.resource.data);
      allow update: if isTeacher() && isValidLabItem(request.resource.data);
      allow delete: if isTeacher();
    }

    // Borrow Permission & Tracking Requests Rules
    match /borrow_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidBorrowRequest(request.resource.data) && request.resource.data.borrowerUid == request.auth.uid;
      allow update: if isAuthenticated() && isValidBorrowRequest(request.resource.data) &&
                    (isTeacher() || (resource.data.borrowerUid == request.auth.uid && request.resource.data.status in ['pending', 'rejected']));
      allow delete: if isTeacher();
    }
  }
}

